<?xml version="1.0" encoding="utf-8"?>
<!-- Todo el tráfico debe ir cifrado (HTTPS). Se confía solo en certificados del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
