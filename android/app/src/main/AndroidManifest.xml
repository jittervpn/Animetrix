<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solo internet. Sin cámara, micrófono, ubicación, contactos ni almacenamiento. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Notificaciones de estrenos y avisos (Android 13+ pide permiso al usuario). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Para que la revisión periódica siga funcionando después de reiniciar el teléfono. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Animetrix"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.Animetrix">

        <!-- Navegación segura de Google para el visor web. -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="true" />
        <!-- Sin métricas de uso del visor web. -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Abrir enlaces de animetrix.lat directamente en la app. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="animetrix.lat" />
                <data android:scheme="https" android:host="www.animetrix.lat" />
            </intent-filter>
        </activity>

        <!-- Revisión periódica de novedades (no se puede invocar desde otras apps). -->
        <service
            android:name=".CheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
